{
  "servers": {
    "context7": { "args": ["-y", "@upstash/context7-mcp@latest"], "command": "npx" },
    "filesystem-ops": {
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"],
      "command": "npx"
    },
    "sequential-thinking": { "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"], "command": "npx" },
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"],
      "env": {
        "LOCALAPPDATA": "C:\\Users\\Alexa\\AppData\\Local",
        "ProgramData": "C:\\ProgramData",
        "ProgramFiles": "C:\\Program Files"
      },
      "type": "stdio"
    }
  }
}
